# Copy this file to .env and fill in the values you actually use.
# Only the providers you plan to call need to be set.

OPENROUTER_API_KEY=your_openrouter_api_key_here
# Optional if you use a different provider in your local config.
# OPENAI_API_KEY=your_openai_api_key_here
# GEMINI_API_KEY=your_gemini_api_key_here
# KIOSAPI_API_KEY=your_kiosapi_key_here
# NVIDIA_API_KEY=your_nvidia_api_key_here

# Frontend origin allowed by the FastAPI backend.
FRONTEND_ORIGIN=http://localhost:4173
