# Copy this file to .env and fill in your own values.

# Hugging Face's OpenAI-compatible router endpoint.
HF_TOKEN=your_hugging_face_token_here
HF_BASE_URL=https://router.huggingface.co/v1
HF_MODEL_ID=zai-org/GLM-5.3-Flash:novita

# Razorpay test-mode credentials, read-only. Only engine/razorpay_client.py uses these.
RAZORPAY_KEY_ID=rzp_test_xxxxxxxxxxxxxx
RAZORPAY_KEY_SECRET=xxxxxxxxxxxxxxxxxxxxxxxx

# Frontend origin allowed by the FastAPI backend.
FRONTEND_ORIGIN=http://localhost:4173
